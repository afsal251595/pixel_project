<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <!-- Interactive 5cm x 5cm Grid View -->
    <com.scientific.pixelgrid.ui.GridOverlayView
        android:id="@+id/gridOverlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Floating HUD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="16dp"
        android:background="#D91E293B"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvGridInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grid: 5cm x 5cm Cells"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTouchFeedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Touch any cell to test recording"
            android:textColor="@color/primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom Close Button -->
    <Button
        android:id="@+id/btnCloseCalibration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/surface_dark"
        android:text="Back to Dashboard"
        android:textColor="@color/text_primary" />

</FrameLayout>
